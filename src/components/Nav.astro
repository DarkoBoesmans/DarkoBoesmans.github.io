---
// Top navigation. On the home page it slides in once the visitor scrolls past the hero (scripts/scroll.ts);
// on legal pages it is always there. Each link lights up in the colour of its section.
import Mark from './Mark.astro';
import Toggles from './Toggles.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Always visible (legal pages). On the home page it appears after the hero. */
  always?: boolean;
}

const { lang, always = false } = Astro.props;
const d = t(lang);
const home = `/${lang}/`;
const links = [
  { href: '#about', label: d.nav.about, key: 'about' },
  { href: '#work', label: d.nav.work, key: 'work' },
  { href: '#contact', label: d.nav.contact, key: 'contact' },
];
---

<header class:list={['c-nav', { 'c-nav--always': always }]} inert={!always}>
  <nav class="c-nav__bar" aria-label={d.nav.label}>
    <a class="c-nav__brand" href={`${home}#top`}>
      <Mark class="c-nav__mark" />
      <span class="c-nav__name">Darko<br />Boesmans</span>
    </a>
    <div class="c-nav__links">
      {
        links.map((l) => (
          <a class={`c-nav__link c-nav__link--${l.key}`} href={`${home}${l.href}`}>
            {l.label}
          </a>
        ))
      }
    </div>
    <Toggles lang={lang} variant="nav" />
  </nav>
</header>
