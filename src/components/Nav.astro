---
interface Props {
  active?: "home" | "work" | "about" | "contact";
}

const { active = "home" } = Astro.props;

const links = [
  { href: "/#work", label: "Work", key: "work" },
  { href: "/about", label: "About", key: "about" },
  { href: "/#contact", label: "Contact", key: "contact" },
];
---

<nav
  id="navbar"
  class="fixed top-6 left-0 right-0 z-50 mx-auto w-fit transition-all duration-500 opacity-0 -translate-y-full"
>
  <!-- Je bestaande code blijft gelijk -->
  <div
    class="flex items-center justify-between gap-6 rounded-full border border-white/10 bg-white/5 px-5 py-3 shadow-glow backdrop-blur-xl"
  >
    <a
      href="/"
      class="font-display text-sm font-bold uppercase tracking-[0.35em] text-white/90"
    >
      Darko Boesmans
    </a>
    <div class="flex items-center gap-2 text-sm text-white/70">
      {
        links.map((link) => (
          <a
            href={link.href}
            class:list={[
              "rounded-full px-3 py-2 transition-colors hover:text-white",
              active === link.key && "bg-white/10 text-white",
            ]}
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>
</nav>
