---
// Top navigation, always visible. Each link carries the colour key of its section.
import Mark from './Mark.astro';
import Toggles from './Toggles.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const home = `/${lang}/`;
const links = [
  { href: '#about', label: d.nav.about, key: 'yellow' },
  { href: '#work', label: d.nav.work, key: 'blue' },
  { href: '#contact', label: d.nav.contact, key: 'red' },
];
---

<header class="c-nav">
  <nav class="c-nav__bar" aria-label={d.nav.label}>
    <a class="c-nav__brand" href={`${home}#top`}>
      <Mark class="c-nav__mark" />
      <span class="c-nav__name">Darko<br />Boesmans</span>
    </a>
    <div class="c-nav__links">
      {
        links.map((l) => (
          <a class={`c-nav__link c-nav__link--${l.key}`} href={`${home}${l.href}`}>
            <span class="c-key" aria-hidden="true" />
            {l.label}
          </a>
        ))
      }
    </div>
    <Toggles lang={lang} variant="nav" />
  </nav>
</header>
