---
// The DB mark: a tiny Mondrian composition in the portfolio colours (same drawing as public/favicon.svg).
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class={className} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <rect width="32" height="32" fill="#151311"></rect>
  <rect x="2" y="2" width="18" height="18" fill="#f4f1ea"></rect>
  <rect x="22" y="2" width="8" height="10" fill="#235347"></rect>
  <rect x="22" y="14" width="8" height="6" fill="#f4f1ea"></rect>
  <rect x="2" y="22" width="10" height="8" fill="#d99b43"></rect>
  <rect x="14" y="22" width="8" height="8" fill="#7a4f2e"></rect>
  <rect x="24" y="22" width="6" height="8" fill="#f4f1ea"></rect>
</svg>
