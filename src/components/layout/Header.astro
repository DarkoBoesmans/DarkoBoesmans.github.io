---
import '../../styles/global.css';

const profile = {
	name: 'Darko Boesmans',
	title: 'Design Engineer & <br />Front-End Developer',
	location: 'Lebbeke, Belgium',
	email: 'info@darkoboesmans.be'
};
---

<header class="header">
	<div class="header-inner">
		<!-- Left Column: About / Profile Card (Golden Ratio ~38.2%) -->
		<div class="about-column">
			<div class="profile-card">
				<div class="profile-image-container">
					<div class="profile-image-placeholder">
						<span>DB</span>
					</div>
				</div>
				<div class="profile-content">
					<h1 class="profile-name">{profile.name}</h1>
					<p class="profile-title" set:html={profile.title}></p>
					<div class="profile-meta">
						<span class="location">{profile.location}</span>
						<a href="mailto:{profile.email}" class="email-link">{profile.email}</a>
					</div>
					<div class="profile-tabs">
						<a href="/about" class="tab-badge">About Me →</a>
					</div>
				</div>
			</div>
		</div>

		<!-- Right Column: Bento Grid (Golden Ratio ~61.8%) -->
		<div class="bento-column">
			<div class="bento-grid">
				<!-- Row 1 -->
				<div class="bento-cell cell-announcement-top">
					<span class="cell-text">Available for new projects</span>
				</div>

				<div class="bento-cell cell-quick-glance-top">
					<span class="cell-row-top">Front end</span>
					<span class="cell-row-bottom">Development</span>
				</div>

				<div class="bento-cell cell-obsessions">
					<span class="cell-row-top">Current Obsessions</span>
					<span class="cell-row-bottom">Using Ollama to train local AI stack.<br />Making my own server to move away from subscriptions</span>
				</div>

				<!-- Row 2 -->
				<div class="bento-cell cell-quick-glance-middle">
					<span class="cell-row-top">Creative</span>
					<span class="cell-row-bottom">Digital solutions</span>
				</div>

				<a href="#work" class="bento-cell cell-link-middle">
					<span class="cell-text">My work</span>
				</a>

				<!-- Row 3 -->
				<a href="#stats" class="bento-cell cell-link-bottom">
					<span class="cell-text">Stats for nerds</span>
				</a>

				<div class="bento-cell cell-social">
					<a href="https://github.com" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="GitHub">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-1.334-.452-.368-.616-1.279-.616-1.279-.502-.852.004-.765.004-.765.554.04 1.009.569 1.009.569.587 1.003 1.538.714 1.915.544.059-.425.23-.715.419-.877-1.333-.151-2.735-.666-2.735-.666-.224-.056-.364-.22-.364-.22-.181-.193.004-.19.004-.19.203.014.31.21.31.21.18.307.476.218.592.167.013-.129.07-.218.127-.268.007-.058.015-.117.022-.176"/></svg>
					</a>
					<a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="LinkedIn">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
					</a>
				</div>

				<a href="#contact" class="bento-cell cell-cta">
					<span class="cell-text">Contact me</span>
				</a>
			</div>
		</div>
	</div>
</header>

<nav class="nav-hidden" id="main-nav">
	<div class="nav-inner">
		<a href="/" class="nav-logo">Darko Boesmans</a>
		<ul class="nav-links">
			<li><a href="#work">Work</a></li>
			<li><a href="/about">About</a></li>
			<li><a href="#contact">Contact</a></li>
		</ul>
	</div>
</nav>

<script>
	const header = document.querySelector('.header');
	const nav = document.getElementById('main-nav');
	let ticking = false;

	function updateNav() {
		const scrollY = window.scrollY;
		const headerHeight = header.offsetHeight;

		if (scrollY > headerHeight) {
			nav.classList.add('nav-visible');
			nav.classList.remove('nav-hidden');
		} else {
			nav.classList.add('nav-hidden');
			nav.classList.remove('nav-visible');
		}

		ticking = false;
	}

	window.addEventListener('scroll', () => {
		if (!ticking) {
			window.requestAnimationFrame(updateNav);
			ticking = true;
		}
	});
</script>

<style>
	:root {
		--color-cream: #F4F1EA;
		--color-forest: #235347;
		--color-cognac: #7A4F2E;
		--color-copper: #D99B43;
		--color-charcoal: #151311;
		--font-heading: 'Fraunces', serif;
		--font-body: 'Space Grotesk', sans-serif;
	}

	* {
		margin: 0;
		padding: 0;
		box-sizing: border-box;
	}

	body {
		background-color: var(--color-cream);
		color: var(--color-charcoal);
		font-family: var(--font-body);
		overflow-x: hidden;
	}

	.header {
		position: relative;
		width: 100vw;
		height: 100vh;
		background-color: var(--color-cream);
	}

	.header-inner {
		display: flex;
		width: 100%;
		height: 100%;
		padding: 1vw;
		gap: 1vw;
	}

	.about-column {
		flex: 0 0 38.2%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.profile-card {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
		max-width: 100%;
	}

	.profile-image-container {
		width: 100%;
		padding-bottom: 125%;
		position: relative;
		overflow: hidden;
		border: 1px solid var(--color-charcoal);
		box-shadow: 0 10px 30px rgba(21, 19, 17, 0.15);
	}

	.profile-image-placeholder {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		background-color: var(--color-cognac);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.profile-image-placeholder span {
		font-family: var(--font-heading);
		font-size: 4rem;
		color: var(--color-cream);
		font-weight: 700;
	}

	.profile-content {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.profile-name {
		font-family: var(--font-heading);
		font-size: clamp(2rem, 4vw, 3rem);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.01em;
		color: var(--color-charcoal);
		text-transform: capitalize;
	}

	.profile-title {
		font-family: var(--font-heading);
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		font-weight: 500;
		line-height: 1.2;
		color: var(--color-cognac);
	}

	.profile-meta {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin-top: 0.5rem;
		font-size: 0.9rem;
	}

	.location {
		color: var(--color-charcoal);
		opacity: 0.8;
	}

	.email-link {
		color: var(--color-copper);
		text-decoration: none;
	}

	.tab-badge {
		display: inline-block;
		padding: 0.5rem 1rem;
		background: transparent;
		border: 1px solid var(--color-copper);
		color: var(--color-copper);
		font-family: var(--font-heading);
		font-weight: 600;
		text-decoration: none;
		border-radius: 4px;
		transition: all 0.3s ease;
	}

	.tab-badge:hover {
		background: var(--color-copper);
		color: var(--color-charcoal);
		transform: translateY(-2px);
	}

	.bento-column {
		flex: 0 0 61.8%;
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.bento-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		grid-template-rows: repeat(3, 1fr);
		gap: 1vw;
		width: 100%;
		height: 100%;
		max-height: 80vh;
	}

	.bento-cell {
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 1.5rem;
		border-radius: 4px;
		text-decoration: none;
		transition: transform 0.4s ease, box-shadow 0.4s ease;
		overflow: hidden;
	}

	.bento-cell:hover {
		transform: translateY(-4px);
		box-shadow: 0 15px 30px rgba(21, 19, 17, 0.15);
	}

	.cell-text,
	.cell-row-top,
	.cell-row-bottom {
		font-family: var(--font-heading);
		text-transform: capitalize;
		line-height: 1.2;
	}

	.cell-row-top {
		font-weight: 700;
		font-size: 1.1rem;
		margin-bottom: 0.25rem;
	}

	.cell-row-bottom {
		font-weight: 400;
		font-size: 0.95rem;
		opacity: 0.9;
	}

	.cell-announcement-top {
		grid-column: 1 / 2;
		grid-row: 1 / 2;
		background: var(--color-cream);
		border: 2px solid var(--color-forest);
		color: var(--color-forest);
	}

	.cell-quick-glance-top {
		grid-column: 2 / 3;
		grid-row: 1 / 2;
		background: var(--color-cognac);
		color: var(--color-cream);
	}

	.cell-obsessions {
		grid-column: 3 / 4;
		grid-row: 1 / 3;
		background: var(--color-cream);
		border: 2px solid var(--color-forest);
		color: var(--color-forest);
	}

	.cell-quick-glance-middle {
		grid-column: 1 / 2;
		grid-row: 2 / 3;
		background: var(--color-cognac);
		color: var(--color-cream);
	}

	.cell-link-middle {
		grid-column: 2 / 3;
		grid-row: 2 / 3;
		background: var(--color-copper);
		color: var(--color-forest);
	}

	.cell-link-middle .cell-text {
		font-weight: 700;
		font-size: 1.2rem;
	}

	.cell-link-bottom {
		grid-column: 1 / 2;
		grid-row: 3 / 4;
		background: var(--color-copper);
		color: var(--color-forest);
	}

	.cell-link-bottom .cell-text {
		font-weight: 700;
		font-size: 1.1rem;
	}

	.cell-social {
		grid-column: 2 / 3;
		grid-row: 3 / 4;
		background: var(--color-charcoal);
		display: flex;
		flex-direction: row;
		padding: 0;
	}

	.social-icon {
		flex: 1;
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--color-cream);
	}

	.social-icon:first-child {
		border-right: 1px solid rgba(244, 241, 234, 0.2);
	}

	.cell-cta {
		grid-column: 3 / 4;
		grid-row: 3 / 4;
		background: var(--color-forest);
		color: var(--color-cream);
		align-items: center;
		justify-content: center;
	}

	.cell-cta .cell-text {
		font-weight: 700;
		font-size: 1.2rem;
	}

	.nav-hidden,
	.nav-visible {
		position: fixed;
		top: 0;
		left: 0;
		width: 100%;
		z-index: 1000;
		transition: transform 0.4s ease;
	}

	.nav-hidden {
		transform: translateY(-100%);
	}

	.nav-visible {
		transform: translateY(0);
		background: rgba(244, 241, 234, 0.9);
		backdrop-filter: blur(20px);
		border-bottom: 1px solid rgba(21, 19, 17, 0.1);
	}

	.nav-inner {
		max-width: 1400px;
		margin: 0 auto;
		padding: 1rem 2rem;
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.nav-logo {
		font-family: var(--font-heading);
		font-weight: 700;
		font-size: 1.25rem;
		color: var(--color-charcoal);
		text-decoration: none;
		text-transform: capitalize;
	}

	.nav-links {
		display: flex;
		gap: 2rem;
		list-style: none;
	}

	.nav-links a {
		font-family: var(--font-body);
		font-weight: 500;
		color: var(--color-charcoal);
		text-decoration: none;
		position: relative;
	}

	.nav-links a::after {
		content: '';
		position: absolute;
		bottom: -4px;
		left: 0;
		width: 0;
		height: 2px;
		background: var(--color-copper);
		transition: width 0.3s ease;
	}

	.nav-links a:hover {
		color: var(--color-copper);
	}

	.nav-links a:hover::after {
		width: 100%;
	}

	@media (max-width: 1024px) {
		.header-inner {
			flex-direction: column;
			padding: 2rem;
		}

		.about-column,
		.bento-column {
			flex: none;
			width: 100%;
		}

		.about-column {
			margin-bottom: 2rem;
		}

		.bento-grid {
			grid-template-columns: repeat(2, 1fr);
			grid-template-rows: auto;
			max-height: none;
		}

		.cell-obsessions {
			grid-column: 1 / 3;
			grid-row: auto;
		}
	}

	@media (max-width: 640px) {
		.bento-grid {
			grid-template-columns: 1fr;
		}

		.cell-obsessions,
		.cell-announcement-top,
		.cell-quick-glance-top,
		.cell-quick-glance-middle,
		.cell-link-middle,
		.cell-link-bottom,
		.cell-social,
		.cell-cta {
			grid-column: 1 / 2;
			grid-row: auto;
		}
	}
</style>