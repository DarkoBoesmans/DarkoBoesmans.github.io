---
// Hero: one Mondrian board. Every coloured plane is a key with one job:
// yellow = about me, blue = my work, red = contact. White planes only inform.
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const h = d.hero;
---

<section id="top" class="c-board c-board--intro c-hero">
  <div class="c-plane c-hero__name" style="--i: 0">
    <p class="c-hero__title">{h.title}</p>
    <h1 class="c-hero__h1">Darko<br />Boesmans</h1>
  </div>

  <a class="c-plane c-plane--yellow c-plane--key c-hero__face" href="#about" style="--i: 1">
    <span class="c-plane__label">{h.tab}</span>
    <img src="/images/profile.webp" alt={h.alt} width="960" height="900" fetchpriority="high" decoding="async" />
    <span class="c-plane__arrow"><Icon name="arrow-down" size={28} /></span>
  </a>

  <div class="c-plane c-hero__role" style="--i: 2">
    <span class="c-plane__label">{h.role}</span>
    <p class="c-hero__spec">{h.front}<span>{h.dev}</span></p>
    <p class="c-hero__spec">{h.creative}<span>{h.digital}</span></p>
  </div>

  <div class="c-plane c-hero__obs" style="--i: 3">
    <h2 class="c-plane__label">{h.obs}</h2>
    <ul>{h.obsItems.map((item) => <li>{item}</li>)}</ul>
  </div>

  <div class="c-plane c-hero__avail" style="--i: 4">
    <span class="c-plane__label">{h.status}</span>
    <p class="c-hero__avail-text"><span class="c-hero__dot" aria-hidden="true"></span>{h.avail}</p>
  </div>

  <a class="c-plane c-plane--blue c-plane--key c-hero__work" href="#work" style="--i: 5">
    <span class="c-plane__label">{d.nav.work}</span>
    <span class="c-plane__title">{h.myWork}</span>
    <span class="c-plane__arrow"><Icon name="arrow-right" size={28} /></span>
  </a>

  <a class="c-plane c-plane--red c-plane--key c-hero__contact" href="#contact" style="--i: 6">
    <span class="c-plane__label">{d.nav.contact}</span>
    <span class="c-plane__title">{h.contactMe}</span>
    <span class="c-plane__arrow"><Icon name="arrow-right" size={28} /></span>
  </a>

  <div class="c-hero__social" style="--i: 7">
    <a class="c-plane c-plane--key" href="https://github.com/DarkoBoesmans" target="_blank" rel="noopener noreferrer" aria-label={`GitHub (${h.newTab})`}>
      <Icon name="github" size={30} />
    </a>
    <a class="c-plane c-plane--key" href="https://www.linkedin.com/in/darkoboesmans" target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn (${h.newTab})`}>
      <Icon name="linkedin" size={30} />
    </a>
  </div>
</section>
