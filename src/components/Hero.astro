---
// Hero: left, an ID card like an event badge (golden-ratio width); right, a board of tiles.
// Coloured tiles are keys: gold = my work, green = contact. The brown card is the "about" colour.
import Icon from './Icon.astro';
import Toggles from './Toggles.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const h = t(lang).hero;
const mailto = `mailto:darkoboesmans@gmail.com?subject=${encodeURIComponent(h.mailSubject)}&body=${encodeURIComponent(h.mailBody)}`;
---

<section id="top" class="c-board c-hero">
  <div class="c-plane c-plane--about c-hero__id" data-dark>
    <a class="c-hero__tab" href="#about">{h.tab}</a>
    <span class="c-hero__slot" aria-hidden="true"></span>
    <Toggles lang={lang} variant="hero" />
    <div class="c-hero__portrait">
      <img src="/images/profile.webp" alt={h.alt} width="960" height="900" fetchpriority="high" decoding="async" data-parallax />
    </div>
    <h1 class="c-hero__name">Darko<br />Boesmans</h1>
    <p class="c-hero__title">{h.title}</p>
    <a class="c-hero__email" href={mailto}>darkoboesmans@gmail.com</a>
  </div>

  <div class="c-hero__grid">
    <div class="c-plane c-hero__tile c-hero__front">
      <span class="c-hero__big">{h.front}</span>
      <span>{h.dev}</span>
    </div>
    <div class="c-plane c-hero__tile c-hero__avail">
      <span class="c-hero__big">{h.avail}</span>
    </div>
    <div class="c-plane c-hero__obs">
      <h2 class="c-hero__big">{h.obs}</h2>
      {h.obsItems.map((item) => <p>{item}</p>)}
    </div>
    <div class="c-plane c-hero__tile c-hero__creative">
      <span class="c-hero__big">{h.creative}</span>
      <span>{h.digital}</span>
    </div>
    <a class="c-plane c-plane--work c-plane--key c-hero__tile c-hero__work" href="#work">
      <span class="c-hero__big">{h.myWork}</span>
    </a>
    <div class="c-hero__social">
      <a class="c-plane c-plane--key c-hero__tile" href="https://github.com/DarkoBoesmans" target="_blank" rel="noopener noreferrer" aria-label={`GitHub (${h.newTab})`}>
        <Icon name="github" size={30} />
      </a>
      <a class="c-plane c-plane--key c-hero__tile" href="https://www.linkedin.com/in/darkoboesmans" target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn (${h.newTab})`}>
        <Icon name="linkedin" size={30} />
      </a>
    </div>
    <a class="c-plane c-plane--contact c-plane--key c-hero__tile c-hero__contact" href="#contact" data-dark>
      <span class="c-hero__big">{h.contactMe}</span>
    </a>
  </div>
</section>
