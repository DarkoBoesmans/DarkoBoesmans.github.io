---
// Hero: profile card (left) and a grid of tiles with role, availability and quick links (right).
import Icon from './Icon.astro';
import Toggles from './Toggles.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const h = t(lang).hero;
const mailto = `mailto:darkoboesmans@gmail.com?subject=${encodeURIComponent(h.mailSubject)}&body=${encodeURIComponent(h.mailBody)}`;
---

<section id="top" class="c-hero">
  <div class="c-hero__profile" data-dark>
    <span class="c-hero__tab">{h.tab}</span>
    <Toggles lang={lang} variant="hero" />
    <div class="c-hero__portrait">
      <img src="/images/profile.webp" alt={h.alt} width="960" height="900" fetchpriority="high" decoding="async" data-parallax />
    </div>
    <h1 class="c-hero__name">Darko<br />Boesmans</h1>
    <a class="c-hero__email" href={mailto}>darkoboesmans@gmail.com</a>
  </div>

  <div class="c-hero__main">
    <p class="c-hero__title">{h.title}</p>
    <div class="c-hero__grid">
      <div class="c-tile c-tile--outline c-hero__avail">
        <span class="c-tile__title">{h.avail}</span>
      </div>
      <div class="c-tile c-tile--brown c-hero__front" data-dark>
        <span class="c-tile__title">{h.front}</span>
        <span class="c-tile__sub">{h.dev}</span>
      </div>
      <div class="c-tile c-tile--outline c-tile--stack c-hero__obs">
        <h2 class="c-tile__title">{h.obs}</h2>
        {h.obsItems.map((item) => <p class="c-tile__text">{item}</p>)}
      </div>
      <div class="c-tile c-tile--brown c-hero__creative" data-dark>
        <span class="c-tile__title">{h.creative}</span>
        <span class="c-tile__sub">{h.digital}</span>
      </div>
      <a class="c-tile c-tile--gold c-tile--link c-hero__work" href="#work">
        <span class="c-tile__title">{h.myWork}</span>
      </a>
      <a class="c-tile c-tile--gold c-tile--link c-hero__stats" href="#about">
        <span class="c-tile__title">{h.stats}</span>
      </a>
      <div class="c-hero__social">
        <a class="c-tile c-tile--ink c-tile--link" href="https://github.com/DarkoBoesmans" target="_blank" rel="noopener noreferrer" aria-label={`GitHub (${h.newTab})`} data-dark>
          <Icon name="github" size={28} />
        </a>
        <a class="c-tile c-tile--ink c-tile--link" href="https://www.linkedin.com/in/darkoboesmans" target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn (${h.newTab})`} data-dark>
          <Icon name="linkedin" size={28} />
        </a>
      </div>
      <a class="c-tile c-tile--green c-tile--link c-hero__contact" href="#contact" data-dark>
        <span class="c-tile__title">{h.contactMe}</span>
      </a>
    </div>
  </div>
</section>
