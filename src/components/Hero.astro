---
// Hero: a dark venue with a spotlight that follows the cursor. Left (38.2%, golden ratio): the access pass.
// Right (61.8%): a board of tiles. Coloured tiles are keys: gold = work, brown = about, green = contact.
import Badge from './Badge.astro';
import Icon from './Icon.astro';
import Toggles from './Toggles.astro';
import { t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const h = t(lang).hero;
---

<section id="top" class="c-hero" data-dark data-hero>
  <Toggles lang={lang} variant="hero" />

  <div class="c-hero__stage">
    <Badge lang={lang} />

    <div class="c-board c-hero__grid" data-parallax="0.05">
      <div class="c-plane c-hero__tile c-hero__front">
        <span class="c-hero__big">{h.front}</span>
        <span>{h.dev}</span>
      </div>
      <div class="c-plane c-hero__tile c-hero__avail">
        <span class="c-hero__big">{h.avail}</span>
      </div>
      <div class="c-plane c-hero__obs">
        <h2 class="c-hero__big">{h.obs}</h2>
        {h.obsItems.map((item) => <p>{item}</p>)}
      </div>
      <div class="c-plane c-hero__tile c-hero__creative">
        <span class="c-hero__big">{h.creative}</span>
        <span>{h.digital}</span>
      </div>
      <a class="c-plane c-plane--work c-plane--key c-hero__tile c-hero__work" href="#work">
        <span class="c-hero__big">{h.myWork}</span>
      </a>
      <a class="c-plane c-plane--about c-plane--key c-hero__tile c-hero__stats" href="#toolkit">
        <span class="c-hero__big">{h.stats}</span>
      </a>
      <div class="c-hero__social">
        <a class="c-plane c-plane--key c-hero__tile" href="https://github.com/DarkoBoesmans" target="_blank" rel="noopener noreferrer" aria-label={`GitHub (${h.newTab})`}>
          <Icon name="github" size={30} />
        </a>
        <a class="c-plane c-plane--key c-hero__tile" href="https://www.linkedin.com/in/darkoboesmans" target="_blank" rel="noopener noreferrer" aria-label={`LinkedIn (${h.newTab})`}>
          <Icon name="linkedin" size={30} />
        </a>
      </div>
      <a class="c-plane c-plane--contact c-plane--key c-hero__tile c-hero__contact" href="#contact">
        <span class="c-hero__big">{h.contactMe}</span>
      </a>
    </div>
  </div>
</section>
