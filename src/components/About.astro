---
// About, in short: what drives me (three bold one-liners), the nagging idea, my skills as a stamp card
// ("Statistics for nerds", target of the hero hall) and life outside work as two stickers. The path lives in Route.
import Icon from './Icon.astro';
import { t, type Lang } from '../i18n';
import { aboutPhoto } from '../data/media';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const a = t(lang).about;

// Each skill group gets its own ink colour, like a different stamp at every booth.
const inks = ['contact', 'about', 'ink', 'work'] as const;
// A small, fixed tilt per stamp (-5° to 5°), so the card looks stamped by hand but never changes.
const tilt = (group: number, item: number): number => ((group * 7 + item * 13) % 11) - 5;
const stickers = [
  { icon: 'tent', tone: 'contact' },
  { icon: 'mountain', tone: 'work' },
] as const;
---

<section id="about" class="o-section c-about">
  <div class="o-container">
    <h2 class="c-about__title" data-reveal data-parallax="-0.06">{a.title[0]} <span class="u-outline">{a.title[1]}</span></h2>

    <div class="c-board c-about__board" data-reveal>
      <blockquote class="c-plane c-plane--about c-about__quote">
        <span class="c-plane__label">{a.quoteLabel}</span>
        <span class="c-about__quote-text">{a.quote}</span>
      </blockquote>
      <div class="c-plane c-about__drives">
        <h3>{a.drives}</h3>
        <ul>
          {a.drivesItems.map((item) => <li><strong>{item.lead}</strong> {item.text}</li>)}
        </ul>
      </div>
      {aboutPhoto && <img class="c-plane" src={aboutPhoto} alt={a.photoAlt} loading="lazy" />}
    </div>

    <section id="toolkit" class="c-stamps" aria-labelledby="stamps-title" data-reveal>
      <div class="c-stamps__head">
        <h3 class="c-stamps__title" id="stamps-title">{a.skillsTitle}</h3>
        <p class="c-stamps__intro">{a.skillsIntro}</p>
      </div>
      <div class="c-stamps__card">
        {
          a.skills.map((group, g) => (
            <div class="c-stamps__row">
              <h4 class="c-stamps__group">{group.name}</h4>
              <ul class="c-stamps__list">
                {group.items.map((item, i) => (
                  <li class={`c-stamp c-stamp--${inks[g]}`} style={`--tilt: ${tilt(g, i)}deg`}>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </section>

    <div class="c-about__beyond" data-reveal>
      <h3>{a.beyond}</h3>
      <div class="c-about__stickers">
        {
          a.beyondItems.map((item, i) => (
            <article class={`c-sticker c-sticker--${stickers[i].tone}`}>
              <span class="c-sticker__icon"><Icon name={stickers[i].icon} size={40} /></span>
              <h4 class="c-sticker__title">{item.title}</h4>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </div>

    <p class="c-about__note">{a.note}</p>
  </div>
</section>
