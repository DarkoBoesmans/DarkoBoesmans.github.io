---
// About: lead and story side by side, one board strip (quote + drive), the spec sheet, life outside work.
import { t, type Lang } from '../i18n';
import { aboutPhoto } from '../data/media';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const a = d.about;
---

<section id="about" class="o-section c-about">
  <div class="o-container">
    <p class="c-label"><span class="c-key c-key--yellow" aria-hidden="true"></span>{d.nav.about}</p>

    <div class="o-grid">
      <h2 class="c-about__lead" data-reveal>{a.pathA} <span>{a.pathB}</span></h2>
      <div class="c-about__story" data-reveal>
        {a.story.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <div class="c-board c-about__board" data-reveal>
      <blockquote class="c-plane c-plane--yellow c-about__quote">
        <span class="c-plane__label">{a.quoteLabel}</span>
        <span class="c-about__quote-text">{a.quote}</span>
      </blockquote>
      <div class="c-plane c-about__drives">
        <h3>{a.drives}</h3>
        {a.drivesItems.map((p) => <p>{p}</p>)}
      </div>
      {aboutPhoto && <img class="c-plane" src={aboutPhoto} alt={a.photoAlt} loading="lazy" />}
    </div>

    <section class="c-specs" aria-labelledby="specs-title" data-reveal>
      <h3 class="c-specs__title" id="specs-title">{a.skillsTitle}</h3>
      <dl>
        {
          a.skills.map((group) => (
            <div class="c-specs__row">
              <dt class="c-specs__name">{group.name}</dt>
              <dd>
                <ul class="c-specs__items">{group.items.map((item) => <li>{item}</li>)}</ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <div class="c-about__beyond" data-reveal>
      <h3>{a.beyond}</h3>
      <div class="c-about__columns">
        {a.beyondItems.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </div>
</section>
