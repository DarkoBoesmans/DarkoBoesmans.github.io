---
// About, in short: what drives me (three bold one-liners), the nagging idea, the spec sheet
// ("Statistics for nerds", target of the hero tile) and life outside work. The path itself lives in Route.
import { t, type Lang } from '../i18n';
import { aboutPhoto } from '../data/media';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const a = t(lang).about;
---

<section id="about" class="o-section c-about">
  <div class="o-container">
    <h2 class="c-about__title" data-reveal data-parallax="-0.06">{a.title}</h2>

    <div class="c-board c-about__board" data-reveal>
      <blockquote class="c-plane c-plane--about c-about__quote">
        <span class="c-plane__label">{a.quoteLabel}</span>
        <span class="c-about__quote-text">{a.quote}</span>
      </blockquote>
      <div class="c-plane c-about__drives">
        <h3>{a.drives}</h3>
        <ul>
          {a.drivesItems.map((item) => <li><strong>{item.lead}</strong> {item.text}</li>)}
        </ul>
      </div>
      {aboutPhoto && <img class="c-plane" src={aboutPhoto} alt={a.photoAlt} loading="lazy" />}
    </div>

    <section id="toolkit" class="c-specs" aria-labelledby="specs-title" data-reveal>
      <h3 class="c-specs__title" id="specs-title">{a.skillsTitle}</h3>
      <dl>
        {
          a.skills.map((group) => (
            <div class="c-specs__row">
              <dt class="c-specs__name">{group.name}</dt>
              <dd>
                <ul class="c-specs__items">{group.items.map((item) => <li>{item}</li>)}</ul>
              </dd>
            </div>
          ))
        }
      </dl>
    </section>

    <div class="c-about__beyond" data-reveal>
      <h3>{a.beyond}</h3>
      <div class="c-about__columns">
        {a.beyondItems.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <p class="c-about__note">{a.note}</p>
  </div>
</section>
