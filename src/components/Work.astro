---
// Featured Work: covers scroll by on the left; the sticky panel on the right shows the project
// whose cover is closest to the middle of the screen (scripts/work.ts). Phones get a caption under each cover.
import { t, type Lang } from '../i18n';
import { projects } from '../data/media';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const w = t(lang).work;
const items = projects.map((p) => ({ ...p, ...w.projects[p.slug] }));
---

<section id="work" class="o-section c-work">
  <div class="o-container">
    <div class="c-work__head">
      <h2 class="c-work__title" data-reveal data-parallax="-0.06">{w.title}</h2>
      <p class="c-work__intro" data-reveal>{w.intro}</p>
    </div>

    <div class="c-work__layout">
      <ol class="c-work__shots">
        {
          items.map((p) => (
            <li class="c-work__shot">
              <div class="c-board c-work__frame">
                <div class="c-plane c-plane--work c-work__cover">
                  {p.image ? (
                    <img src={p.image} alt={`${p.title} | ${w.screenshot}`} loading="lazy" data-parallax="0.08" />
                  ) : (
                    <>
                      <span class="c-work__type" aria-hidden="true" data-parallax="0.05">{p.title}</span>
                      <span class="c-work__note">{w.empty}</span>
                    </>
                  )}
                </div>
              </div>
              <div class="c-work__caption">
                <h3 class="c-work__name">{p.title}</h3>
                <p>{p.desc}</p>
                <p class="c-work__tags">{w.built}: {p.tags.join(', ')}</p>
              </div>
            </li>
          ))
        }
      </ol>

      <div class="c-work__aside">
        <div class="c-work__panels">
          {
            items.map((p, i) => (
              <article class:list={['c-work__panel', { 'is-active': i === 0 }]} aria-hidden={i === 0 ? 'false' : 'true'}>
                <h3 class="c-work__name c-work__name--large">{p.title}</h3>
                <p class="c-work__desc">{p.desc}</p>
                <p class="c-work__tags">{w.built}: {p.tags.join(', ')}</p>
              </article>
            ))
          }
        </div>
        <div class="c-work__markers">
          {
            items.map((p, i) => (
              <button class:list={['c-work__marker', { 'is-active': i === 0 }]} type="button" aria-pressed={i === 0 ? 'true' : 'false'}>
                {p.title}
              </button>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
