---
// Work: a catalogue of projects. Each one is a small board: blue cover (work colour) and a text plane.
import { t, type Lang } from '../i18n';
import { projects } from '../data/media';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const w = d.work;
const items = projects.map((p) => ({ ...p, ...w.projects[p.slug] }));
---

<section id="work" class="o-section c-work">
  <div class="o-container">
    <p class="c-label"><span class="c-key c-key--work" aria-hidden="true"></span>{d.nav.work}</p>

    <div class="c-work__head">
      <h2 class="c-work__title" data-reveal>{w.title}</h2>
      <p class="c-work__intro" data-reveal>{w.intro}</p>
    </div>

    <ol class="c-work__list">
      {
        items.map((p) => (
          <li class="c-board c-project" data-reveal>
            <div class="c-plane c-plane--work c-project__cover">
              {p.image ? (
                <img src={p.image} alt={`${p.title} | ${w.screenshot}`} loading="lazy" />
              ) : (
                <>
                  <span class="c-project__type" aria-hidden="true">{p.title}</span>
                  <span class="c-project__note">{w.empty}</span>
                </>
              )}
            </div>
            <div class="c-plane c-project__body">
              <h3 class="c-project__name">{p.title}</h3>
              <p class="c-project__desc">{p.desc}</p>
              <div class="c-project__tags">
                <p class="c-project__tags-label">{w.built}</p>
                <ul>{p.tags.map((tag) => <li>{tag}</li>)}</ul>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
