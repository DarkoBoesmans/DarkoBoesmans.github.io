---
// Featured Work: covers scroll by on the left; the sticky panel on the right shows the project
// whose cover is closest to the middle of the screen (scripts/work.ts). A numbered index jumps to any project.
// Phones get a caption under each cover instead of the panel.
import { t, type Lang } from '../i18n';
import { projects } from '../data/media';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = t(lang);
const w = d.work;
const items = projects.map((p) => ({ ...p, ...w.projects[p.slug] }));
---

<section id="work" class="o-section c-work">
  <div class="o-container">
    <div class="c-work__head">
      <h2 class="c-work__title" data-reveal data-parallax="-0.06">{w.title[0]} <span class="u-outline">{w.title[1]}</span></h2>
      <p class="c-work__intro" data-reveal>{w.intro}</p>
    </div>

    <div class="c-work__layout">
      <ol class="c-work__shots">
        {
          items.map((p) => (
            <li class="c-work__shot">
              <div class="c-board c-work__frame">
                <div class="c-plane c-plane--work c-work__cover">
                  {p.image ? (
                    <img src={p.image} alt={`${p.title} | ${w.screenshot}`} loading="lazy" data-parallax="0.06" />
                  ) : (
                    <>
                      <span class="c-work__type" aria-hidden="true">{p.title}</span>
                      <span class="c-work__note">{w.empty}</span>
                    </>
                  )}
                </div>
              </div>
              <div class="c-work__caption">
                <h3 class="c-work__name">{p.title}</h3>
                <p>{p.desc}</p>
                <p class="c-work__tags">{w.built}: {p.tags.join(', ')}</p>
                {p.url && <a class="c-button c-button--small" href={p.url} target="_blank" rel="noopener noreferrer">{w.visit} {p.title} ↗</a>}
              </div>
            </li>
          ))
        }
      </ol>

      <div class="c-work__aside">
        <div class="c-work__panels">
          {
            items.map((p, i) => (
              <article class:list={['c-work__panel', { 'is-active': i === 0 }]} aria-hidden={i === 0 ? 'false' : 'true'}>
                <h3 class="c-work__name c-work__name--large">{p.title}</h3>
                <p class="c-work__desc">{p.desc}</p>
                <p class="c-work__tags">{w.built}: {p.tags.join(', ')}</p>
                {p.url && (
                  <a class="c-button c-button--ink" href={p.url} target="_blank" rel="noopener noreferrer" tabindex={i === 0 ? undefined : -1}>
                    {w.visit} {p.title} ↗
                  </a>
                )}
              </article>
            ))
          }
        </div>
        <ol class="c-work__markers">
          {
            items.map((p, i) => (
              <li>
                <button class:list={['c-work__marker', { 'is-active': i === 0 }]} type="button" aria-pressed={i === 0 ? 'true' : 'false'}>
                  <span class="c-work__index">{String(i + 1).padStart(2, '0')}</span>
                  {p.title}
                </button>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>
