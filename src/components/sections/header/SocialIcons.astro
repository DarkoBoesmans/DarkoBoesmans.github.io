---
import GitHubIcon from './GitHubIcon.astro';
import LinkedInIcon from './LinkedInIcon.astro';
---

<div class="col-span-1 row-span-1 bg-[color:var(--color-charcoal)] rounded-xl flex overflow-hidden">
  <a href="https://github.com/DarkoBoesmans" target="_blank" rel="noopener noreferrer" class="flex-1 flex items-center justify-center text-[color:var(--color-cream)] hover:bg-[color:var(--color-cream)]/10 transition-colors" aria-label="GitHub Profile">
    <GitHubIcon />
  </a>
  <a href="https://linkedin.com/in/darkoboesmans" target="_blank" rel="noopener noreferrer" class="flex-1 flex items-center justify-center text-[color:var(--color-cream)] hover:bg-[color:var(--color-cream)]/10 transition-colors border-l border-[color:var(--color-cream)]/20" aria-label="LinkedIn Profile">
    <LinkedInIcon />
  </a>
</div>
