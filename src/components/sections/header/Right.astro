---
interface Props {
  profileImage?: string;
}

const { profileImage = "/profile-pic.jpg" } = Astro.props;

import BentoGrid from './BentoGrid.astro';
---

<!-- Main Title with Line Break - Above Grid -->
<div class="mb-6 lg:mb-8" data-reveal>
  <h1 class="font-display text-[clamp(2.5rem,5vw,4rem)] font-extrabold tracking-tight leading-[1.05] text-[color:var(--color-forest)]">
    Design Engineer &amp;<br />Front-End Developer
  </h1>
</div>

<!-- Bento Grid -->
<BentoGrid />
