---
interface Props {
  profileImage?: string;
}

const { profileImage = "/profile-pic.jpg" } = Astro.props;

import Right from './header/Right.astro';
import Left from './header/Left.astro';
---

<div class="w-full h-full flex flex-col">
  
  <!-- Golden Ratio Split: Left (smaller ~38.2%) | Right (larger ~61.8%) -->
  <div class="grid grid-cols-1 gap-4 lg:gap-[1vw] lg:grid-cols-[0.382fr_0.618fr] flex-1 min-h-0">
    
    <!-- LEFT COLUMN -->
    <Left profileImage={profileImage} />
    
    <!-- RIGHT COLUMN -->
    <Right profileImage={profileImage} />
    
  </div>
</div>
