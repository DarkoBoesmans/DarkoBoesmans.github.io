---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import { projects, type ProjectData } from "../content/data";

export const getStaticPaths = ({ params }: { params: { slug: string } }) => {
  return Object.entries(projects).map(([slug, project]) => ({
    params: { slug },
    props: { project },
  }));
};

const { project } = Astro.props as { project: ProjectData };
---


<BaseLayout title={`${project.title} | Darko Boesmans`} description={project.outcome}>
  <Header active="work" />

  <main class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
    <section class="rounded-[2rem] border border-white/10 bg-white/5 p-8 shadow-glow backdrop-blur-xl">
      <p class="text-xs uppercase tracking-[0.35em] text-white/45">Case study</p>
      <h1 class="mt-4 font-display text-4xl text-white sm:text-5xl">{project.title}</h1 >
      <p class="mt-4 max-w-3xl text-base leading-7 text-white/72">{project.outcome}</p>
    </section>

    <section class="mt-8 grid gap-4 lg:grid-cols-3">
      <article class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-glow backdrop-blur-xl">
        <h2 class="text-lg font-semibold text-white">Overview</h2>
        <p class="mt-4 text-sm leading-7 text-white/72"><strong class="text-white">Client</strong><br />{project.client}</p>
        <p class="mt-4 text-sm leading-7 text-white/72"><strong class="text-white">Goal</strong><br />{project.goal}</p>
        <p class="mt-4 text-sm leading-7 text-white/72"><strong class="text-white">Outcome</strong><br />{project.outcome}</p>
      </article>

      <article class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-glow backdrop-blur-xl">
        <h2 class="text-lg font-semibold text-white">Challenge</h2>
        <p class="mt-4 text-sm leading-7 text-white/72">{project.challenge}</p>
      </article>

      <article class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-glow backdrop-blur-xl">
        <h2 class="text-lg font-semibold text-white">Results</h2>
        <p class="mt-4 text-sm leading-7 text-white/72">{project.results}</p>
      </article>
    </section>

    <section class="mt-8 grid gap-4 lg:grid-cols-2">
      <article class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-glow backdrop-blur-xl">
        <h2 class="text-lg font-semibold text-white">Process</h2>
        <p class="mt-4 text-sm leading-7 text-white/72"><strong class="text-white">Research</strong><br />{project.research}</p>
        <ul class="mt-5 flex flex-wrap gap-2">
          {project.tools.map((tool) => (
            <li class="rounded-full border border-white/10 bg-black/20 px-3 py-1 text-xs text-white/70">{tool}</li>
          ))}
        </ul>
      </article>

      <article class="rounded-3xl border border-white/10 bg-white/5 p-6 shadow-glow backdrop-blur-xl">
        <h2 class="text-lg font-semibold text-white">Solution</h2>
        <p class="mt-4 text-sm leading-7 text-white/72">{project.solution}</p>
        <a href={project.link} class="mt-6 inline-flex text-sm font-medium text-cyan-300 transition-colors hover:text-cyan-200" target="_blank" rel="noreferrer">
          Check out the live website
        </a>
      </article>
    </section>

    <section class="mt-8 rounded-3xl border border-white/10 bg-white/5 p-6 shadow-glow backdrop-blur-xl">
      <h2 class="text-lg font-semibold text-white">Reflection</h2>
      <p class="mt-4 text-sm leading-7 text-white/72">{project.reflection}</p>
    </section>
  </main>

  <Footer />
</BaseLayout>