---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Hero from "../components/sections/Header.astro";
import About from "../components/sections/About.astro";
import Contact from "../components/sections/Contact.astro";
import Footer from "../components/layout/Footer.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
---

<BaseLayout title="Darko Boesmans | Portfolio" description="Modern portfolio scaffold built with Astro, TypeScript, Tailwind, Keystatic, and GSAP.">
  <Header active="home" />

  <main>
    <Hero />

    <section id="work" class="mx-auto max-w-7xl px-6 py-16 lg:px-8">
      <div class="flex items-end justify-between gap-6" data-reveal>
        <div>
          <p class="text-xs uppercase tracking-[0.35em] text-white/45">Work</p>
          <h2 class="mt-4 font-display text-3xl text-white">Selected case studies</h2>
        </div>
        {projects.length > 0 && (
          <a href={`/projects/${projects[0].slug}`} class="text-sm text-[color:var(--color-accent)] transition-colors hover:text-[color:var(--color-accent)]/80">Open latest case study</a>
        )}
      </div>

      <!-- Project Grid -->
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
        {projects.map((project) => (
          <article class="group relative overflow-hidden rounded-2xl bg-[color:var(--color-secondary)] p-6 shadow-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl">
            <div class="absolute inset-0 bg-gradient-to-br from-[color:var(--color-accent)]/10 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
            <div class="relative z-10">
              <h3 class="font-display text-xl font-bold text-[color:var(--color-white)] group-hover:text-[color:var(--color-accent)] transition-colors">
                <a href={`/projects/${project.slug}`}>
                  {project.data.title}
                </a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-white)]/80">
                {project.data.description}
              </p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {project.data.tools.slice(0, 3).map((tool) => (
                  <li class="rounded-full border border-[color:var(--color-accent)]/30 bg-[color:var(--color-black)]/20 px-3 py-1 text-xs text-[color:var(--color-white)]/70">
                    {tool}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <About />
    <Contact />
  </main>

  <Footer />

  <script type="module">
    import { initHomeAnimations } from "../utils/animations";

    initHomeAnimations();
  </script>
</BaseLayout>