---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/layout/Header.astro";
import Hero from "../components/sections/Header.astro";
import About from "../components/sections/About.astro";
import Contact from "../components/sections/Contact.astro";
import Footer from "../components/layout/Footer.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");

// Extract all unique tools for filtering
const allTools = [...new Set(projects.flatMap(p => p.data.tools))].sort();
---

<BaseLayout title="Darko Boesmans | Design Engineer & Front-End Developer" description="Portfolio of Darko Boesmans, a Design Engineer & Front-End Developer based in Belgium specializing in accessible, performant web experiences.">
  <Header active="home">
    <Hero />
  </Header>
  
  <main class="relative z-10 bg-[color:var(--color-cream)]">

    <section id="work" class="mx-auto max-w-7xl px-6 py-16 lg:px-8 bg-[color:var(--color-cream)]">
      <div class="flex items-end justify-between gap-6" data-reveal>
        <div>
          <p class="text-xs uppercase tracking-[0.35em] text-[color:var(--color-forest)]/45">Work</p>
          <h2 class="mt-4 font-display text-3xl text-[color:var(--color-forest)]">Selected case studies</h2>
        </div>
        {projects.length > 0 && (
          <a href={`/projects/${projects[0].slug}`} class="text-sm text-[color:var(--color-accent)] transition-colors hover:text-[color:var(--color-accent)]/80">Open latest case study</a>
        )}
      </div>

      <!-- Filter Controls -->
      <div class="mt-8 flex flex-wrap items-center gap-2" data-reveal>
        <button 
          data-filter="all"
          class="filter-btn rounded-full border border-[color:var(--color-copper)]/30 bg-[color:var(--color-copper)]/20 px-4 py-1.5 text-xs font-medium text-[color:var(--color-copper)] transition-all hover:bg-[color:var(--color-copper)] hover:text-[color:var(--color-charcoal)] active-filter"
        >
          All
        </button>
        {allTools.map((tool) => (
          <button 
            data-filter={tool.toLowerCase()}
            class="filter-btn rounded-full border border-[color:var(--color-forest)]/10 bg-[color:var(--color-forest)]/5 px-4 py-1.5 text-xs font-medium text-[color:var(--color-forest)]/70 transition-all hover:border-[color:var(--color-copper)]/30 hover:bg-[color:var(--color-copper)]/20 hover:text-[color:var(--color-copper)]"
          >
            {tool}
          </button>
        ))}
      </div>

      <!-- Project Grid -->
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-reveal>
        {projects.map((project) => (
          <article 
            class="group relative overflow-hidden rounded-2xl bg-[color:var(--color-secondary)] p-6 shadow-xl transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl project-card"
            data-tools={project.data.tools.join(",").toLowerCase()}
          >
            <div class="absolute inset-0 bg-gradient-to-br from-[color:var(--color-accent)]/10 to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100"></div>
            <div class="relative z-10">
              <h3 class="font-display text-xl font-bold text-[color:var(--color-cream)] group-hover:text-[color:var(--color-accent)] transition-colors">
                <a href={`/projects/${project.slug}`}>
                  {project.data.title}
                </a>
              </h3>
              <p class="mt-2 text-sm leading-relaxed text-[color:var(--color-cream)]/80">
                {project.data.description}
              </p>
              <ul class="mt-4 flex flex-wrap gap-2">
                {project.data.tools.slice(0, 3).map((tool) => (
                  <li class="rounded-full border border-[color:var(--color-accent)]/30 bg-[color:var(--color-black)]/20 px-3 py-1 text-xs text-[color:var(--color-white)]/70">
                    {tool}
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>
    </section>

    <About />
    <Contact />
  </main>

  <Footer />

  <script type="module">
    import { initHomeAnimations } from "../utils/animations";

    initHomeAnimations();
    
    // Project filtering functionality
    const filterButtons = document.querySelectorAll('.filter-btn');
    const projectCards = document.querySelectorAll('.project-card');
    
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        
        // Update active state
        filterButtons.forEach(b => {
          b.classList.remove('bg-[color:var(--color-copper)]/20', 'text-[color:var(--color-copper)]', 'border-[color:var(--color-copper)]/30');
          b.classList.add('bg-white/5', 'text-white/70', 'border-white/10');
        });
        btn.classList.remove('bg-white/5', 'text-white/70', 'border-white/10');
        btn.classList.add('bg-[color:var(--color-copper)]/20', 'text-[color:var(--color-copper)]', 'border-[color:var(--color-copper)]/30');
        
        // Filter projects
        projectCards.forEach(card => {
          const tools = card.getAttribute('data-tools');
          if (filter === 'all' || tools?.includes(filter)) {
            card.style.display = 'block';
            card.animate([
              { opacity: 0, transform: 'scale(0.9)' },
              { opacity: 1, transform: 'scale(1)' }
            ], { duration: 300, easing: 'cubic-bezier(0.25, 0.1, 0.25, 1)' });
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  </script>
</BaseLayout>
