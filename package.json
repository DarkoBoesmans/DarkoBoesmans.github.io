{
  "name": "darko-boesmans-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "biome check .",
    "format": "biome check --write .",
    "keystatic": "keystatic",
    "cms": "keystatic",
    "clean": "rm -rf dist/ .astro/ node_modules/",
    "reinstall": "npm run clean && npm install",
    "typecheck": "tsc --noEmit",
    "validate": "npm run check && npm run lint",
    "prebuild": "npm run validate",
    "postbuild": "echo 'Build complete! Preview with: npm run preview'"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.5",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/tailwind": "6.0.2",
    "@keystatic/astro": "^6.0.0",
    "astro": "7.2.1",
    "astro-og-canvas": "^0.13.0",
    "gsap": "^3.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^22.16.5",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
